<?xml version="1.0" ?>
<!-- SPDX-License-Identifier: Apache-2.0
     Clean Square Room World for OOMWOO Robot Vacuum
     A 6.0 x 6.0 m obstacle-free room enclosed by 4 walls.
-->
<sdf version="1.8">
  <world name="default">
    <physics type="ode">
      <real_time_update_rate>200</real_time_update_rate>
      <max_step_size>0.005</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </visual>
      </link>
    </model>

    <!-- Outer Walls (6.0 m x 6.0 m interior space, centered at 0,0) -->
    <!-- North Wall -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 3.1 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>6.4 0.2 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>6.4 0.2 0.5</size></box></geometry></visual>
      </link>
    </model>
    <!-- South Wall -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -3.1 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>6.4 0.2 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>6.4 0.2 0.5</size></box></geometry></visual>
      </link>
    </model>
    <!-- East Wall -->
    <model name="wall_east">
      <static>true</static>
      <pose>3.1 0 0.25 0 0 1.5708</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>6.4 0.2 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>6.4 0.2 0.5</size></box></geometry></visual>
      </link>
    </model>
    <!-- West Wall -->
    <model name="wall_west">
      <static>true</static>
      <pose>-3.1 0 0.25 0 0 1.5708</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>6.4 0.2 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>6.4 0.2 0.5</size></box></geometry></visual>
      </link>
    </model>

  </world>
</sdf>
